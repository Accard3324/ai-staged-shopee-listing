# Copy this file to .env. Never commit .env or any real credential.

# Default API and model used by Steps 3, 5, 6, and 7.
AI_PROVIDER=openai
AI_EXECUTION_MODE=multimodal
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6
OPENAI_MAX_OUTPUT_TOKENS=32768
OPENAI_TIMEOUT_SECONDS=900

STEP3_AI_MODEL=gpt-5.6
STEP5_AI_MODEL=gpt-5.6
STEP6_AI_MODEL=gpt-5.6
STEP7_AI_MODEL=gpt-5.6
STEP3_THINKING_MODE=official_default
STEP5_THINKING_MODE=official_default
STEP6_THINKING_MODE=official_default
STEP7_THINKING_MODE=official_default
STEP3_REASONING_STRENGTH=official_default
STEP5_REASONING_STRENGTH=official_default
STEP6_REASONING_STRENGTH=official_default
STEP7_REASONING_STRENGTH=official_default

# Optional alternative model APIs. Leave blank unless you select those model IDs.
AGNES_API_KEY=
AGNES_VISION_BASE_URL=https://apihub.agnes-ai.com/v1
NVIDIA_VISION_API_KEY=
NVIDIA_VISION_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MINIMAX_VISION_API_KEY=
NVIDIA_MINIMAX_VISION_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_API_KEY=
NVIDIA_TEXT_BASE_URL=https://integrate.api.nvidia.com/v1
ZHIPU_API_KEY=

AI_API_MAX_REQUESTS_PER_MINUTE=40
AI_API_SAFE_REQUESTS_PER_MINUTE=40
VISION_CONCURRENCY=8
FULL_WORKFLOW_AUTO_RETRY_COUNT=1

# Optional personal notifications.
SERVERCHAN_ENABLED=false
SERVERCHAN_SENDKEY=
WXPUSHER_ENABLED=false
WXPUSHER_SPT=
